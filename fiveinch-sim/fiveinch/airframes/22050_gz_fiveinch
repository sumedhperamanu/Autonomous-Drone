#!/bin/sh
#
# @name Gazebo 5-inch quad (team design, phase 1 numbers from eCalc)
#
# @type Quadrotor
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=fiveinch}

param set-default SIM_GZ_EN 1

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

param set-default CA_ROTOR0_PX 0.078
param set-default CA_ROTOR0_PY 0.078
param set-default CA_ROTOR0_KM  0.05

param set-default CA_ROTOR1_PX -0.078
param set-default CA_ROTOR1_PY -0.078
param set-default CA_ROTOR1_KM  0.05

param set-default CA_ROTOR2_PX 0.078
param set-default CA_ROTOR2_PY -0.078
param set-default CA_ROTOR2_KM -0.05

param set-default CA_ROTOR3_PX -0.078
param set-default CA_ROTOR3_PY 0.078
param set-default CA_ROTOR3_KM -0.05

param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

param set-default SIM_GZ_EC_MIN1 470
param set-default SIM_GZ_EC_MIN2 470
param set-default SIM_GZ_EC_MIN3 470
param set-default SIM_GZ_EC_MIN4 470

param set-default SIM_GZ_EC_MAX1 3121
param set-default SIM_GZ_EC_MAX2 3121
param set-default SIM_GZ_EC_MAX3 3121
param set-default SIM_GZ_EC_MAX4 3121

param set-default MPC_THR_HOVER 0.36
# No ground station needed to arm in the sim (set to 2 once QGroundControl is connected)
param set-default NAV_DLL_ACT 0

# Keep peak current inside a 6S 1800 mAh pack's limit
param set-default MPC_THR_MAX 0.8
