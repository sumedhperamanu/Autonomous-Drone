#!/bin/sh
#
# @name Gazebo 7-inch quad on 4S (2807 1700KV, 7x3.5 two-blade, 4S 5000 mAh)
#
# @type Quadrotor
#
# Same body and props as 22052. Only the top motor speed changes: a 1700 KV motor on
# 4S tops out lower than a 1300 KV motor on 6S (calc/four.py). The model's 1.32 kg body
# matches the 4S drone with the phase 2 payload (1.31 kg), so the model is shared.

# Started as gz_seveninch_4s, but it flies the shared seveninch model
PX4_SIM_MODEL=seveninch

. ${R}etc/init.d-posix/airframes/22052_gz_seveninch

param set-default SIM_GZ_EC_MIN1 295
param set-default SIM_GZ_EC_MIN2 295
param set-default SIM_GZ_EC_MIN3 295
param set-default SIM_GZ_EC_MIN4 295
param set-default SIM_GZ_EC_MAX1 1964
param set-default SIM_GZ_EC_MAX2 1964
param set-default SIM_GZ_EC_MAX3 1964
param set-default SIM_GZ_EC_MAX4 1964
# Hover output measured in sim: 0.386
param set-default MPC_THR_HOVER 0.39
