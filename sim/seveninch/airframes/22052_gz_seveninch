#!/bin/sh
#
# @name Gazebo 7-inch quad (option B: 2807 1300KV, 7x3.5 two-blade, 6S 4000 mAh)
#
# @type Quadrotor
#
# The 6S version, kept for comparison. The team's pick is 4S (22054), which reuses this file.
# Motor numbers come from my motor model (sim/calc). The Nov 3 eCalc runs agree on thrust and
# hover throttle within 15%, so they were left as is.
# Rotors at +-0.104 m = 295 mm motor to motor.

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=seveninch}

param set-default SIM_GZ_EN 1

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

param set-default CA_ROTOR0_PX 0.104
param set-default CA_ROTOR0_PY 0.104
param set-default CA_ROTOR0_KM  0.012

param set-default CA_ROTOR1_PX -0.104
param set-default CA_ROTOR1_PY -0.104
param set-default CA_ROTOR1_KM  0.012

param set-default CA_ROTOR2_PX 0.104
param set-default CA_ROTOR2_PY -0.104
param set-default CA_ROTOR2_KM -0.012

param set-default CA_ROTOR3_PX -0.104
param set-default CA_ROTOR3_PY 0.104
param set-default CA_ROTOR3_KM -0.012

param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

# Idle = 15% of max speed, same ratio as the x500 and the 5-inch model
param set-default SIM_GZ_EC_MIN1 332
param set-default SIM_GZ_EC_MIN2 332
param set-default SIM_GZ_EC_MIN3 332
param set-default SIM_GZ_EC_MIN4 332

param set-default SIM_GZ_EC_MAX1 2213
param set-default SIM_GZ_EC_MAX2 2213
param set-default SIM_GZ_EC_MAX3 2213
param set-default SIM_GZ_EC_MAX4 2213

# Expected hover output: (940 - 332) / (2213 - 332) = 0.32
# Hover thrust PX4 learned in the sim (hover_thrust_estimate 0.323)
param set-default MPC_THR_HOVER 0.32
# No ground station needed to arm in the sim (set to 2 once QGroundControl is connected)
param set-default NAV_DLL_ACT 0

# Rate gains from the Day 4 gain sweep (2026-11-03): hover stayed smooth up to
# K 0.85 and shook at 1.0, so the baseline sits at about half the shake point.
# The real drone still needs its own tune (start low, then autotune).
param set-default MC_ROLLRATE_K 0.5
param set-default MC_PITCHRATE_K 0.5
