#!/bin/sh
#
# @name Gazebo x500 with the perception sensors (OAK-D Lite, MTF-01, no GPS)
#
# @type Quadrotor
#

PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500_perception}

. ${R}etc/init.d-posix/airframes/4001_gz_x500

# Sim only: let it arm with no ground station connected
param set-default NAV_DLL_ACT 0

# GPS-denied: docs/PERCEPTION_REQUIREMENTS.md assumption 1
param set-default SYS_HAS_GPS 0
param set-default SIM_GPS_USED 0
param set-default EKF2_GPS_CTRL 0

# Assumptions 2 and 4: v_max 1.5 m/s, 1.0 m/s nominal, braking 2 m/s^2
param set-default MPC_XY_VEL_MAX 1.5
param set-default MPC_XY_CRUISE 1.0
param set-default MPC_VEL_MANUAL 1.5
param set-default MPC_ACC_HOR 2.0
