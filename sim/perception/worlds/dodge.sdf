<?xml version="1.0" encoding="UTF-8"?>
<!--
  Moving-obstacle test world for P-13 and P-14. Same physics and lighting as PX4's default world,
  plus objects you can send at the drone:
    ball_7cm, ball_20cm   balls from the P-13 table
    person                a 0.5 m wide, 1.7 m tall stand-in (a detector won't see it as a person)
  Each one is moved with its own velocity topic, for example:
    gz topic -t /model/ball_7cm/cmd_vel -m gz.msgs.Twist -p 'linear: {x: -2.0}'
  The velocity holds until you send a new one, so send 'linear: {x: 0}' to stop it.
-->
<sdf version="1.9">
  <world name="dodge">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1 1</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
    </light>

    <!-- 7 cm ball, 6 m ahead at hover height. Send it with a negative x velocity. -->
    <model name="ball_7cm">
      <pose>6 0 2.5 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial><mass>0.05</mass><inertia><ixx>2.5e-05</ixx><iyy>2.5e-05</iyy><izz>2.5e-05</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.035</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
    </model>

    <!-- 20 cm ball, 6 m to the left at hover height. Send it with a negative y velocity. -->
    <model name="ball_20cm">
      <pose>0 6 2.5 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial><mass>0.2</mass><inertia><ixx>8e-04</ixx><iyy>8e-04</iyy><izz>8e-04</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.1</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
          <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
    </model>

    <!-- Person stand-in, 8 m ahead and 3 m to the right, standing on the ground. -->
    <model name="person">
      <pose>8 -3 0.85 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial><mass>70</mass><inertia><ixx>17</ixx><iyy>17</iyy><izz>2.2</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.2 0.6 0.2 1</ambient><diffuse>0.2 0.6 0.2 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
    </model>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
