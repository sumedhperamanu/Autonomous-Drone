<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <!--
    P1's 5" drone (fiveinch) with the perception sensors: OAK-D Lite, STL-27L lidar and MTF-01P.
    Positions come from cad/skeleton.py on p3/interface-agreement. The CAD measures heights from the prop
    plane, which sits 0.0269 m above base_link here, so every z below is the CAD height + 0.0269.
    Sensor links carry 1 g each: set the body mass in fiveinch_base to the weighed drone.
  -->
  <model name='fiveinch_perception'>
    <self_collide>false</self_collide>
    <include merge='true'>
      <uri>model://fiveinch</uri>
    </include>

    <!-- OAK-D Lite under the nose, forward, tilted up 8 deg. Stereo depth, left mono and IMU. -->
    <link name="oakd_link">
      <pose relative_to="base_link">0.070 0 -0.0351 0 -0.1396 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-07</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-07</iyy><iyz>0</iyz><izz>1e-07</izz></inertia>
      </inertial>
      <visual name="oakd_visual">
        <pose>-0.00358 0.03 -0.014 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://OakD-Lite/meshes/OakDLite.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <sensor name="oakd_depth" type="depth_camera">
        <gz_frame_id>oakd_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.274</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.2</near>
            <far>12</far>
          </clip>
          <!-- The datasheet's error at 3 m (under 2%). Gazebo applies it at every range. -->
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.06</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>depth_camera</topic>
      </sensor>
      <sensor name="oakd_left" type="camera">
        <gz_frame_id>oakd_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.274</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>oakd/left/image</topic>
      </sensor>
      <sensor name="oakd_imu" type="imu">
        <gz_frame_id>oakd_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <topic>oakd/imu</topic>
      </sensor>
    </link>
    <joint name="oakd_joint" type="fixed">
      <parent>base_link</parent>
      <child>oakd_link</child>
    </joint>

    <!--
      STL-27L 2D lidar on a rear mast, scan plane 73 mm above the props, clear of the battery: 360 deg,
      0.167 deg apart (2160 points per turn), 10 Hz, 25 m. PX4 reads this exact link and sensor name for
      obstacle_distance, so they match PX4's lidar_2d_v2 model.
    -->
    <link name="link">
      <pose relative_to="base_link">-0.062 0 0.0999 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-07</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-07</iyy><iyz>0</iyz><izz>1e-07</izz></inertia>
      </inertial>
      <!-- Body sized like the LD19 (about 39 x 39 x 34 mm), which P1 says the STL-27L matches. -->
      <visual name="stl27l_visual">
        <pose>0 0 -0.009 0 0 0</pose>
        <geometry><cylinder><radius>0.0195</radius><length>0.034</length></cylinder></geometry>
        <material><ambient>0.55 0.35 0.1 1</ambient><diffuse>0.55 0.35 0.1 1</diffuse></material>
      </visual>
      <sensor name="lidar_2d_v2" type="gpu_lidar">
        <gz_frame_id>link</gz_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>2160</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.03</min>
            <max>25</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="lidar_2d_joint" type="fixed">
      <parent>base_link</parent>
      <child>link</child>
    </joint>

    <!-- MTF-01P under the rear of the frame: downward flow and a 0.02 to 12 m range beam. PX4 reads these names. -->
    <include merge='true'>
      <uri>model://optical_flow</uri>
      <pose relative_to="base_link">-0.063 0 -0.0146 0 0 0</pose>
    </include>
    <joint name="optical_flow_joint" type="fixed">
      <parent>base_link</parent>
      <child>flow_link</child>
    </joint>
    <link name="lidar_sensor_link">
      <pose relative_to="base_link">-0.063 0 -0.0146 0 1.5707 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-07</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-07</iyy><iyz>0</iyz><izz>1e-07</izz></inertia>
      </inertial>
      <sensor name="lidar" type="gpu_lidar">
        <gz_frame_id>lidar_sensor_link</gz_frame_id>
        <pose>0 0 0 3.14 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range>
            <min>0.02</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="lidar_sensor_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_sensor_link</child>
    </joint>
  </model>
</sdf>
