<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_perception'>
    <self_collide>false</self_collide>
    <include merge='true'>
      <uri>x500</uri>
    </include>

    <!-- Forward depth, OAK-D Lite (P-1 to P-5). Mount pose is PX4's x500_depth until we have CAD. -->
    <link name="oakd_link">
      <pose relative_to="base_link">0.12 0.03 0.002 0 0 0</pose>
      <inertial>
        <pose>0.00358 -0.03 0.014 0 0 0</pose>
        <mass>0.061</mass>
        <inertia>
          <ixx>0.0000460804</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0000055421</iyy><iyz>0</iyz><izz>0.0000436519</izz>
        </inertia>
      </inertial>
      <visual name="oakd_visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://OakD-Lite/meshes/OakDLite.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <sensor name="oakd_depth" type="depth_camera">
        <gz_frame_id>oakd_link</gz_frame_id>
        <pose>0.01233 -0.03 0.01878 0 0 0</pose>
        <camera>
          <horizontal_fov>1.274</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.2</near>
            <far>12</far>
          </clip>
          <!-- The datasheet's error at 3 m (under 2%). Gazebo applies it at every range. -->
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.06</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>depth_camera</topic>
      </sensor>
    </link>
    <joint name="oakd_joint" type="fixed">
      <parent>base_link</parent>
      <child>oakd_link</child>
    </joint>

    <!-- Downward flow, MTF-01 (P-7). PX4 reads these by name, so the link and sensor names stay as PX4 has them. -->
    <include merge='true'>
      <uri>model://optical_flow</uri>
      <pose relative_to="base_link">0.03 0 -0.1 0 0 0</pose>
    </include>
    <joint name="optical_flow_joint" type="fixed">
      <parent>base_link</parent>
      <child>flow_link</child>
    </joint>

    <!-- Downward range, MTF-01: 0.02 to 8 m (P-7) -->
    <link name="lidar_sensor_link">
      <pose relative_to="base_link">0 0 -0.05 0 1.57 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name="lidar" type="gpu_lidar">
        <gz_frame_id>lidar_sensor_link</gz_frame_id>
        <pose>0 0 0 3.14 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range>
            <min>0.02</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="lidar_sensor_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_sensor_link</child>
    </joint>
  </model>
</sdf>
